void generuotiFaila(string pavadinimas, int kiek) {
    ofstream fr(pavadinimas);
    if (!fr) {
        cout << "Nepavyko sukurti failo: " << pavadinimas << endl;
        return;
    }

    fr << "Vardas Pavarde ND1 ND2 ND3 ND4 Egz" << endl;

    for (int i = 1; i <= kiek; i++) {
        fr << "Vardas" << i << " "
           << "Pavarde" << i << " "
           << (rand() % 10 + 1) << " "
           << (rand() % 10 + 1) << " "
           << (rand() % 10 + 1) << " "
           << (rand() % 10 + 1) << " "
           << (rand() % 10 + 1) << endl;

    }

